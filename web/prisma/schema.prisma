// ====================================================================
// 27B. MODULES & PERMISSIONS (Staff Permission System)
// ====================================================================

model Module {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(64)
  label       String       @db.VarChar(255)
  icon        String?      @db.VarChar(255)
  description String?
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  permissions Permission[]

  @@index([code])
  @@index([sortOrder])
  @@map("modules")
}

model Permission {
  id               String            @id @default(uuid()) @db.Uuid
  moduleId         String            @map("module_id") @db.Uuid
  module           Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  code             String            @unique @db.VarChar(64)
  action           String?           @db.VarChar(64)
  label            String            @db.VarChar(255)
  description      String?
  sortOrder        Int               @default(0) @map("sort_order")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  staffPermissions StaffPermission[]

  @@index([moduleId])
  @@index([code])
  @@index([isActive])
  @@map("permissions")
}

model StaffPermission {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@map("staff_permissions")
}

// ====================================================================
// 28. SITE_CONTENT (CMS nội dung trang public)
// ====================================================================

model SiteContent {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique @db.VarChar(64)
  content       Json
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedById   String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_content")
}

// ====================================================================
// 30. KHUONGFB_PRODUCTS (Sản phẩm nhập từ khuongfb.com)
// ====================================================================
model ExternalProduct {
  id                 String             @id @default(uuid()) @db.Uuid
  provider           String             @default("khuongfb") @db.VarChar(50)
  externalId         String             @map("external_id")
  externalCategory   String             @map("external_category")
  name               String
  description        String?
  thumbnail          String?
  originalPrice      Decimal            @db.Decimal(18, 2) @map("original_price")
  salePrice          Decimal            @db.Decimal(18, 2) @map("sale_price")
  isEnabled          Boolean            @default(false) @map("is_enabled")
  warrantyInfo       String?            @map("warranty_info")
  displaySection     StoreType          @default(TAI_NGUYEN_MMO) @map("display_section")
  resourceCategoryId String?            @map("resource_category_id") @db.Uuid
  resourceCategory   ResourceCategory?  @relation(fields: [resourceCategoryId], references: [id], onDelete: SetNull)
  subCategoryId      String?            @map("sub_category_id") @db.Uuid
  subCategory        SellerSubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  rawData            Json?              @map("raw_data")
  syncedAt           DateTime?          @map("synced_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  orders Order[]

  @@unique([provider, externalId])
  @@index([provider])
  @@index([provider, isEnabled])
  @@index([isEnabled])
  @@index([displaySection])
  @@index([resourceCategoryId])
  @@index([subCategoryId])
  @@map("external_products")
}

// ====================================================================
// 29. PRODUCT_FAVORITES (Yêu thích sản phẩm)
// ====================================================================

model ProductFavorite {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  productType FavoriteProductType @map("product_type")
  productId   String              @map("product_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")

  @@unique([userId, productType, productId])
  @@index([userId])
  @@index([productType, productId])
  @@map("product_favorites")
}

// ====================================================================
// 29B. PRODUCT_IMAGES (Gallery ảnh sản phẩm — tối đa 10 ảnh/sản phẩm)
// ====================================================================

model ProductImage {
  id          String              @id @default(uuid()) @db.Uuid
  productType FavoriteProductType @map("product_type")
  productId   String              @map("product_id") @db.Uuid
  imageUrl    String              @map("image_url")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([productType, productId, createdAt])
  @@map("product_images")
}

// ====================================================================
// 30. COUPONS (Mã giảm giá — Kho tài nguyên / Tài nguyên MMO / Khương FB)
// ====================================================================

// Áp dụng cho: SELLER_PRODUCT (kho tài nguyên) / MMO_PRODUCT (nguyên liệu) / KHUONGFB_PRODUCT.
// Dùng lại OrderType thay vì khai enum riêng để tránh trùng lặp danh sách loại sản phẩm.
model Coupon {
  id            String              @id @default(uuid()) @db.Uuid
  code          String              @unique @db.VarChar(50)
  name          String
  discountType  CouponDiscountType  @map("discount_type")
  discountValue Decimal             @db.Decimal(18, 2) @map("discount_value")
  maxUses       Int                 @map("max_uses")
  usedCount     Int                 @default(0) @map("used_count")
  minOrderValue Decimal?            @db.Decimal(18, 2) @map("min_order_value")
  // Ngưỡng tier tối thiểu — khớp với label trong DISCOUNT_TIERS (lib/utils/discount.ts): "Thẻ" | "Silver" | "Gold". Null = không giới hạn.
  minTierLabel  String?             @map("min_tier_label") @db.VarChar(20)
  // Chỉ áp dụng cho user chưa từng có Order nào (mua lần đầu)
  newUserOnly   Boolean             @default(false) @map("new_user_only")
  startAt       DateTime            @map("start_at")
  endAt         DateTime            @map("end_at")
  isActive      Boolean             @default(true) @map("is_active")
  createdBy     String              @map("created_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")

  products    CouponProduct[]
  redemptions CouponRedemption[]
  orders      Order[]

  @@index([code])
  @@index([isActive, startAt, endAt])
  @@map("coupons")
}

model CouponProduct {
  id          String    @id @default(uuid()) @db.Uuid
  couponId    String    @map("coupon_id") @db.Uuid
  coupon      Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productType OrderType @map("product_type")
  productId   String    @map("product_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([couponId, productType, productId])
  @@index([productType, productId])
  @@map("coupon_products")
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String   @unique @map("order_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  // Chốt quy tắc "1 tài khoản chỉ dùng 1 lần" ở tầng DB — chống race condition
  @@unique([couponId, userId])
  @@map("coupon_redemptions")
}
