// ====================================================================
// Generator & Datasource
// ====================================================================
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  
}

// ====================================================================
// ENUMS
// ====================================================================
enum Role {
  USER
  SELLER
  STAFF
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  BANNED
  DELETED
}

enum SellerStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum Platform {
  FACEBOOK
  TIKTOK
  GOOGLE
  INSTAGRAM
  YOUTUBE
  ICLOUD
  ZALO
  TELEGRAM
  TWITTER
  OTHER
}

enum LearningFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum CourseBadge {
  NONE
  HOT
  POPULAR
  TREND
  NEW
  VIP
}

enum OrderType {
  SERVICE
  COURSE
  TUTTRICK
  MMO_PRODUCT
  SELLER_PRODUCT
  KHUONGFB_PRODUCT
}

enum FavoriteProductType {
  SERVICE
  COURSE
  TUTTRICK
  MMO_PRODUCT
  SELLER_PRODUCT
  KHUONGFB_PRODUCT
}

enum OrderStatus {
  PENDING
  PROCESSING
  DONE
  CANCELLED
  REFUNDED
  DISPUTED
  FROZEN
}

enum TxType {
  DEPOSIT_AUTO
  DEPOSIT_MANUAL
  BUY_SERVICE
  BUY_COURSE
  BUY_TUTTRICK
  BUY_MMO_PRODUCT
  BUY_SELLER_PRODUCT
  BUY_KHUONGFB_PRODUCT
  COURSE_DEPOSIT
  COURSE_FINAL_PAYMENT
  REFUND
  SELLER_REGISTRATION
  SELLER_SLOT_PURCHASE
  SELLER_PAYOUT
  WITHDRAWAL_FEE
  ADMIN_ADJUSTMENT
  COMPLAINT_DEDUCTION
  ESCROW_DEPOSIT
  AFFILIATE_COMMISSION
  AFFILIATE_COMMISSION_VOID
  AFFILIATE_WITHDRAWAL_FEE
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
}

enum BankChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OtpPurpose {
  REGISTER
  LOGIN_2FA
  RESET_PASSWORD
  EMAIL_VERIFY
  WITHDRAWAL_CONFIRM
  SENSITIVE_ACTION
}

enum NotificationType {
  DEPOSIT
  PURCHASE
  ORDER_STATUS
  SELLER_APPROVED
  WITHDRAWAL_STATUS
  SYSTEM
  PROMOTION
}

enum ComplaintStatus {
  IN_REVIEW      // đang chat (không còn OPEN — chat room tạo ngay)
  PENDING_ADMIN  // user bấm "chưa xong" → admin phán quyết
  RESOLVED       // seller thắng (tiền pass seller)
  REJECTED       // user thắng (hoàn tiền)
}

enum StockItemStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum StoreType {
  TAI_NGUYEN_MMO
  KHO_TAI_NGUYEN
}

enum SellerProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AffiliateStatus {
  ACTIVE
  LOCKED
}

enum AffiliateCommissionStatus {
  PENDING
  APPROVED
  VOIDED
}

enum AffiliateWithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum CouponDiscountType {
  PERCENT
  FIXED_AMOUNT
}

// ====================================================================
// 1. USERS & AUTH
// ====================================================================
model User {
  id                   String        @id @default(uuid()) @db.Uuid

  email                String        @unique @db.VarChar(255)
  emailVerifiedAt      DateTime?     @map("email_verified_at")
  passwordHash         String        @map("password_hash")
  fullName             String        @map("full_name")
  phone                String?

  role                 Role          @default(USER)
  status               AccountStatus @default(PENDING_VERIFICATION)

  balance              Decimal       @default(0) @db.Decimal(18, 2)
  totalDeposited       Decimal       @default(0) @db.Decimal(18, 2) @map("total_deposited")
  totalSpent           Decimal       @default(0) @db.Decimal(18, 2) @map("total_spent")
  sellerEscrow         Decimal       @default(0) @db.Decimal(18, 2) @map("seller_escrow")
  // Mức ký quỹ tối thiểu yêu cầu riêng cho seller này — admin nâng lên thì seller phải tự nạp thêm để đủ điều kiện rút tiền
  sellerEscrowRequired Decimal       @default(1000000) @db.Decimal(18, 2) @map("seller_escrow_required")

  // Giảm giá khi mua Service/Course/TutTrick
  // 0 = dùng tier tự động theo totalDeposited; > 0 = admin override cứng
  discountPercent      Int           @default(0) @map("discount_percent")

  // Giảm giá "Đại lý" — chỉ áp dụng Tài nguyên MMO / Kho nguyên liệu / Khương FB
  // 0 = không phải đại lý; > 0 = % cố định, admin gán tay, không phụ thuộc totalDeposited
  // Ưu tiên cao hơn discountPercent/tier tự động cho các loại sản phẩm trên
  agentDiscountPercent Int           @default(0) @map("agent_discount_percent")

  sellerStatus         SellerStatus  @default(NONE) @map("seller_status")
  sellerTier           String        @default("STANDARD") @map("seller_tier") @db.VarChar(50)
  sellerCategory       String?       @map("seller_category")
  maxSellerProducts    Int           @default(10) @map("max_seller_products")

  bankNameEnc          Bytes?        @map("bank_name_enc")
  bankAccountNumberEnc Bytes?        @map("bank_account_number_enc")
  bankAccountHolderEnc Bytes?        @map("bank_account_holder_enc")
  cccdImageUrl         String?       @map("cccd_image_url")
  portraitImageUrl     String?       @map("portrait_image_url")
  facebookUrl          String?       @map("facebook_url") @db.VarChar(500)
  telegramUsername     String?       @map("telegram_username") @db.VarChar(100)

  // Thông báo đơn hàng qua Telegram bot (chỉ seller dùng)
  // chat_id số được webhook tự bắt khi seller bấm Start bot — seller không tự nhập
  sellerTelegramChatId String?       @map("seller_telegram_chat_id") @db.VarChar(32)
  // Token 1 lần dùng cho deep link /start — xoá sau khi kết nối thành công
  telegramLinkToken    String?       @unique @map("telegram_link_token") @db.VarChar(64)

  avatarUrl            String?       @map("avatar_url") @db.VarChar(500)

  // ── Lifetime Affiliate ──────────────────────────────────────────────
  isAffiliate          Boolean         @default(false) @map("is_affiliate")
  affiliateStatus      AffiliateStatus @default(ACTIVE) @map("affiliate_status")
  affiliateCode        String?         @unique @map("affiliate_code") @db.VarChar(32)
  affiliateJoinedAt    DateTime?       @map("affiliate_joined_at")
  // First-touch, permanent attribution — who referred THIS user (set once, only Admin can change)
  referrerAffiliateId  String?         @map("referrer_affiliate_id") @db.Uuid
  referrerAffiliate    User?           @relation("AffiliateReferrals", fields: [referrerAffiliateId], references: [id])
  referredUsers        User[]          @relation("AffiliateReferrals")

  twoFactorSecretEnc   Bytes?        @map("two_factor_secret_enc")
  twoFactorEnabled     Boolean       @default(false) @map("two_factor_enabled")
  shopLocked           Boolean       @default(false) @map("shop_locked")

  // Admin gắn cờ này cho seller cụ thể cần nộp lại CCCD + ảnh chân dung trước khi rút tiền
  sellerReverifyRequired Boolean     @default(false) @map("seller_reverify_required")
  // Một khi được duyệt xác minh lại thì luôn giữ true — không cần xác minh lại lần nữa
  sellerReverifyApproved Boolean     @default(false) @map("seller_reverify_approved")

  lastLoginAt          DateTime?     @map("last_login_at")
  lastLoginIp          String?       @map("last_login_ip")
  failedLoginCount     Int           @default(0) @map("failed_login_count")
  lockedUntil          DateTime?     @map("locked_until")

  // 8 ký tự đầu UUID (bỏ dấu -) dùng cho SePay webhook matching
  uidPrefix            String        @map("uid_prefix") @db.VarChar(8)

  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  deletedAt            DateTime?     @map("deleted_at")

  sessions             Session[]
  refreshTokens        RefreshToken[]
  orders               Order[]
  transactions         Transaction[]
  notifications        Notification[]
  sellerRequest        SellerRequest?
  sellerProducts       SellerProduct[]
  sellerWithdrawals    SellerWithdrawal[]
  bankChangeRequests   BankChangeRequest[]
  reverifyRequests     SellerReverifyRequest[]
  reviews              Review[]
  complaints           Complaint[]
  auditLogsAsActor     AuditLog[]    @relation("AuditActor")
  loginAttempts        LoginAttempt[]
  chatParticipations   ChatParticipant[]
  chatMessages         ChatMessage[]
  supportTicketsAsBuyer  SupportTicket[]  @relation("SupportTicketBuyer")
  supportTicketsAsSeller SupportTicket[]  @relation("SupportTicketSeller")
  supportMessages        SupportMessage[]
  subCategories        UserSubCategory[]
  staffPermissions     StaffPermission[]
  siteContentUpdates   SiteContent[]
  favorites            ProductFavorite[]
  couponRedemptions    CouponRedemption[]

  affiliateCommissionRules       AffiliateCommissionRule[] @relation("AffiliateOwnerRules")
  affiliateCommissionsEarned     AffiliateCommission[]     @relation("AffiliateEarner")
  affiliateCommissionsAsCustomer AffiliateCommission[]     @relation("AffiliateCustomer")
  affiliateClicks                AffiliateClick[]
  affiliateWithdrawals           AffiliateWithdrawal[]

  @@index([email])
  @@index([uidPrefix])
  @@index([status])
  @@index([role])
  @@index([sellerStatus])
  @@index([affiliateCode])
  @@index([referrerAffiliateId])
  @@index([isAffiliate, affiliateStatus])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique @map("session_token") @db.VarChar(128)
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  family    String    @db.VarChar(64)
  revoked   Boolean   @default(false)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  email      String
  ipAddress  String   @map("ip_address")
  userAgent  String?  @map("user_agent")
  success    Boolean
  failReason String?  @map("fail_reason")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

// ====================================================================
// 2. SERVICES
// ====================================================================
model ServiceCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  iconUrl      String?  @map("icon_url")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("service_categories")
}

// Nhân sự hiển thị theo từng danh mục dịch vụ (ảnh + tên + chức vụ + mô tả)
// category = ServiceCategory.name / Service.category (tham chiếu theo tên, không FK — đồng nhất với Service.category)
model CategoryStaff {
  id           String   @id @default(uuid()) @db.Uuid
  category     String
  name         String
  role         String
  description  String?  @db.Text
  avatarUrl    String?  @map("avatar_url")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("category_staff")
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  slug            String    @unique
  name            String
  thumbnail       String?
  platform        Platform
  category        String
  price           Decimal   @db.Decimal(18, 2)
  successRate     Int       @default(100) @map("success_rate")
  processingTime  String?   @map("processing_time")
  rating          Float     @default(0)
  totalOrders     Int       @default(0) @map("total_orders")
  totalViews      Int       @default(0) @map("total_views")
  isActive        Boolean   @default(true) @map("is_active")
  isFeatured      Boolean   @default(false) @map("is_featured")
  description     String?
  seoTitle        String?   @map("seo_title")
  seoDescription  String?   @map("seo_description")
  customerCount    Int       @default(0) @map("customer_count")
  reviewCount      Int       @default(0) @map("review_count")
  platformVariants Json      @default("[]") @map("platform_variants")
  warrantyOptions  Json      @default("[]") @map("warranty_options")
  productList      Json      @default("[]") @map("product_list")
  displayOrder        Int       @default(0) @map("display_order")
  requiresAccountType Boolean   @default(false) @map("requires_account_type")
  requiresCccd        Boolean   @default(false) @map("requires_cccd")
  requiresTitle       Boolean   @default(false) @map("requires_title")
  requiresSampleFile  Boolean   @default(false) @map("requires_sample_file")
  showAccountPass     Boolean   @default(true)  @map("show_account_pass")
  showGmailPass       Boolean   @default(true)  @map("show_gmail_pass")
  showLinkUrl         Boolean   @default(true)  @map("show_link_url")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  orders          Order[]
  testimonials    Testimonial[]

  @@index([slug])
  @@index([platform])
  @@index([isActive, isFeatured])
  @@index([category])
  @@map("services")
}

// ====================================================================
// 3. COURSES
// ====================================================================
model CourseCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  icon         String   @default("") // URL icon từ svgl.app
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([displayOrder])
  @@map("course_categories")
}

model Course {
  id               String         @id @default(uuid()) @db.Uuid
  slug             String         @unique
  name             String
  thumbnail        String?
  description      String?
  category         String
  learningFormat   LearningFormat @map("learning_format")
  originalPrice    Decimal        @db.Decimal(18, 2) @map("original_price")
  salePrice        Decimal        @db.Decimal(18, 2) @map("sale_price")
  duration         String?
  studentCount     Int            @default(0) @map("student_count")
  instructorName   String?        @map("instructor_name")
  rating           Float          @default(0)
  contentList      Json           @default("[]") @map("content_list")
  platformVariants Json           @default("[]") @map("platform_variants")
  badge            CourseBadge    @default(NONE)
  saleDeadline     DateTime?      @map("sale_deadline") @db.Date
  youtubeUrl       String?        @map("youtube_url")
  seoTitle         String?        @map("seo_title")
  seoDescription   String?        @map("seo_description")
  totalOrders      Int            @default(0) @map("total_orders")
  totalViews       Int            @default(0) @map("total_views")
  isActive            Boolean        @default(true) @map("is_active")
  displayOrder        Int            @default(0) @map("display_order")
  requiresAccountType     Boolean        @default(false) @map("requires_account_type")
  requiresCccd            Boolean        @default(false) @map("requires_cccd")
  commitments             Json           @default("[]") @map("commitments")
  registrationProcedure   String?        @map("registration_procedure")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  orders           Order[]
  testimonials     Testimonial[]
  faqCategories    CourseFaqCategory[]
  faqs             CourseFaq[]
  supportItems     CourseSupportItem[]

  @@index([slug])
  @@index([category])
  @@index([isActive, displayOrder])
  @@map("courses")
}

model CourseFaqCategory {
  id           String      @id @default(uuid()) @db.Uuid
  courseId     String      @map("course_id") @db.Uuid
  name         String
  displayOrder Int         @default(0) @map("display_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  course       Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faqs         CourseFaq[]

  @@index([courseId, displayOrder])
  @@map("course_faq_categories")
}

model CourseFaq {
  id           String             @id @default(uuid()) @db.Uuid
  courseId     String             @map("course_id") @db.Uuid
  categoryId   String?            @map("category_id") @db.Uuid
  question     String
  answer       String
  displayOrder Int                @default(0) @map("display_order")
  isActive     Boolean            @default(true) @map("is_active")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category     CourseFaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([courseId, displayOrder])
  @@map("course_faqs")
}

model CourseSupportItem {
  id           String   @id @default(uuid()) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  icon         String   @default("✅")
  title        String
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, displayOrder])
  @@map("course_support_items")
}

// ====================================================================
// 4. TUT_TRICKS
// ====================================================================
model TutTrick {
  id             String    @id @default(uuid()) @db.Uuid
  slug           String    @unique
  name           String
  thumbnail      String?
  platform       Platform
  category       String
  tier           String    @default("Miễn phí")
  price          Decimal   @db.Decimal(18, 2) @default(0)
  description    String?
  contentUrlEnc  Bytes?    @map("content_url_enc")
  docs           String?
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  warrantyPolicy String?   @map("warranty_policy")
  processingTime String?   @map("processing_time")
  isActive            Boolean   @default(true) @map("is_active")
  isFeatured          Boolean   @default(false) @map("is_featured")
  totalOrders         Int       @default(0) @map("total_orders")
  totalViews          Int       @default(0) @map("total_views")
  successRate         Int       @default(100) @map("success_rate")
  rating              Float     @default(0)
  displayOrder        Int       @default(0) @map("display_order")
  publishedDate       DateTime? @map("published_date") @db.Date
  requiresAccountType Boolean   @default(false) @map("requires_account_type")
  requiresCccd        Boolean   @default(false) @map("requires_cccd")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  orders         Order[]

  @@index([slug])
  @@index([platform])
  @@index([isActive, isFeatured])
  @@map("tut_tricks")
}

// ====================================================================
// 5. MMO_PRODUCTS + ITEMS
// ====================================================================
model MmoProduct {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique
  name          String
  thumbnail     String?
  category      String
  categoryGroup String    @map("category_group")
  price         Decimal   @db.Decimal(18, 2)
  description   String?
  warrantyInfo  String    @default("") @map("warranty_info") @db.Text
  rating        Float     @default(0)
  totalOrders   Int       @default(0) @map("total_orders")
  totalViews    Int       @default(0) @map("total_views")
  isActive            Boolean    @default(true) @map("is_active")
  isFeatured          Boolean    @default(false) @map("is_featured")
  displayOrder        Int        @default(0) @map("display_order")
  requiresAccountType Boolean    @default(false) @map("requires_account_type")
  requiresCccd        Boolean    @default(false) @map("requires_cccd")
  section             StoreType  @default(TAI_NGUYEN_MMO)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  items         MmoProductItem[]
  variants      MmoProductVariant[]
  orders        Order[]

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@index([section])
  @@map("mmo_products")
}

model MmoProductVariant {
  id           String     @id @default(uuid()) @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  product      MmoProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantName  String?    @map("variant_name")
  variantPrice Decimal    @db.Decimal(18, 2) @map("variant_price")
  warranty     String     @default("") @map("warranty")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@index([productId])
  @@map("mmo_product_variants")
}

model MmoProductItem {
  id           String          @id @default(uuid()) @db.Uuid
  productId    String          @map("product_id") @db.Uuid
  product      MmoProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  valueEnc     Bytes           @map("value_enc")
  valueHash    String?         @map("value_hash") // SHA-256 của plaintext đã normalize; NULL cho item cũ
  status       StockItemStatus @default(AVAILABLE)
  soldToUserId String?         @map("sold_to_user_id") @db.Uuid
  orderId      String?         @map("order_id") @db.Uuid
  soldAt       DateTime?       @map("sold_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@unique([productId, valueHash]) // PostgreSQL bỏ qua NULL trong unique constraint
  @@index([productId, status])
  @@index([orderId])
  @@map("mmo_product_items")
}

// ====================================================================
// 6. RESOURCE CATEGORIES
// ====================================================================
model ResourceCategory {
  id                   String              @id @default(uuid()) @db.Uuid
  name                 String              @unique
  iconUrl              String?             @map("icon_url")
  displayOrder         Int                 @default(0) @map("display_order")
  showInKhoTaiNguyen   Boolean             @default(true) @map("show_in_kho_tai_nguyen")
  showInTaiNguyenMmo   Boolean             @default(true) @map("show_in_tai_nguyen_mmo")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  subCategories    SellerSubCategory[]
  externalProducts ExternalProduct[]

  @@index([name])
  @@map("resource_categories")
}

// ====================================================================
// 6b. SELLER SUB-CATEGORIES
// ====================================================================
model SellerSubCategory {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String
  categoryName         String   @map("category_name")
  displayOrder         Int      @default(0) @map("display_order")
  isActive             Boolean  @default(true) @map("is_active")
  showInKhoTaiNguyen   Boolean  @default(true) @map("show_in_kho_tai_nguyen")
  showInTaiNguyenMmo   Boolean  @default(true) @map("show_in_tai_nguyen_mmo")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  category         ResourceCategory  @relation(fields: [categoryName], references: [name], onDelete: Cascade)
  users            UserSubCategory[]
  products         SellerProduct[]
  externalProducts ExternalProduct[]

  @@unique([categoryName, name])
  @@index([categoryName, isActive])
  @@map("seller_sub_categories")
}

model UserSubCategory {
  userId        String @map("user_id") @db.Uuid
  subCategoryId String @map("sub_category_id") @db.Uuid

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subCategory   SellerSubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@id([userId, subCategoryId])
  @@map("user_sub_categories")
}

model TutTrickCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  iconUrl      String?  @map("icon_url")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("tut_trick_categories")
}

// ====================================================================
// 7. ORDERS
// ====================================================================
model Order {
  id              String         @id @default(uuid()) @db.Uuid
  orderCode       String         @unique @map("order_code")
  userId          String         @map("user_id") @db.Uuid
  user            User           @relation(fields: [userId], references: [id])

  orderType       OrderType      @map("order_type")
  serviceId       String?        @map("service_id") @db.Uuid
  service         Service?       @relation(fields: [serviceId], references: [id])
  courseId        String?        @map("course_id") @db.Uuid
  course          Course?        @relation(fields: [courseId], references: [id])
  tutTrickId      String?        @map("tut_trick_id") @db.Uuid
  tutTrick        TutTrick?      @relation(fields: [tutTrickId], references: [id])
  mmoProductId    String?        @map("mmo_product_id") @db.Uuid
  mmoProduct      MmoProduct?    @relation(fields: [mmoProductId], references: [id])
  sellerProductId    String?          @map("seller_product_id") @db.Uuid
  sellerProduct      SellerProduct?   @relation(fields: [sellerProductId], references: [id])
  sellerId           String?          @map("seller_id") @db.Uuid
  externalProductId  String?          @map("external_product_id") @db.Uuid
  externalProduct    ExternalProduct? @relation(fields: [externalProductId], references: [id])
  externalOrderId    String?          @map("external_order_id")
  externalSource     String?          @map("external_source") @db.VarChar(50)
  couponId           String?          @map("coupon_id") @db.Uuid
  coupon             Coupon?          @relation(fields: [couponId], references: [id])

  itemName        String         @map("item_name")
  originalPrice   Decimal        @db.Decimal(18, 2) @map("original_price")
  finalPrice      Decimal        @db.Decimal(18, 2) @map("final_price")
  warrantyVariant String?        @map("warranty_variant")
  customerNote    String?        @map("customer_note")
  paymentMethod   String         @default("BALANCE") @map("payment_method")
  status          OrderStatus    @default(PENDING)

  deliveredItemId       String?        @map("delivered_item_id") @db.Uuid
  tutTrickContentUrlEnc Bytes?         @map("tut_trick_content_url_enc")
  tutTrickDocs          String?        @map("tut_trick_docs")
  kfbData               Json?          @map("kfb_data")
  idempotencyKey        String?        @unique @map("idempotency_key")
  withdrawn             Boolean        @default(false)

  // Deposit payment fields (used when course price is 25M–100M)
  paymentType     String         @default("FULL") @map("payment_type") @db.VarChar(20)
  depositAmount   Decimal?       @db.Decimal(18, 2) @map("deposit_amount")
  remainingAmount Decimal?       @db.Decimal(18, 2) @map("remaining_amount")
  finalPaidAt     DateTime?      @map("final_paid_at")

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  completedAt     DateTime?      @map("completed_at")

  transactions    Transaction[]
  review          Review?
  affiliateCommission AffiliateCommission?
  supportTicket       SupportTicket?

  @@index([userId, createdAt])
  @@index([status])
  @@index([orderType])
  @@index([sellerId])
  @@index([orderCode])
  @@map("orders")
}

// ====================================================================
// 7. TRANSACTIONS
// ====================================================================
model Transaction {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id])
  orderId       String?  @map("order_id") @db.Uuid
  order         Order?   @relation(fields: [orderId], references: [id])
  type          TxType
  amount        Decimal  @db.Decimal(18, 2)
  description   String
  balanceBefore Decimal  @db.Decimal(18, 2) @map("balance_before")
  balanceAfter  Decimal  @db.Decimal(18, 2) @map("balance_after")
  referenceCode   String?  @unique @map("reference_code")
  metadata        Json?
  transactionDate String?  @db.VarChar(30) @map("transaction_date")
  accountNumber   String?  @db.VarChar(50) @map("account_number")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([type])
  @@index([referenceCode])
  @@map("transactions")
}

// ====================================================================
// 8. NOTIFICATIONS
// ====================================================================
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false) @map("is_read")
  meta      Json?
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ====================================================================
// 9. SELLER_REQUESTS
// ====================================================================
model SellerRequest {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @map("user_id") @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         String
  storeType        StoreType    @default(TAI_NGUYEN_MMO) @map("store_type")
  fee              Decimal      @default(50000) @db.Decimal(18, 2)
  status           SellerStatus @default(PENDING)
  approvedCategory String?      @map("approved_category")
  rejectReason     String?      @map("reject_reason")
  reviewedByUserId String?      @map("reviewed_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  approvedAt       DateTime?    @map("approved_at")
  rejectedAt       DateTime?    @map("rejected_at")

  @@index([status])
  @@map("seller_requests")
}

// ====================================================================
// 10. SELLER_PRODUCTS + STOCK
// ====================================================================
model SellerProduct {
  id              String    @id @default(uuid()) @db.Uuid
  sellerId        String    @map("seller_id") @db.Uuid
  seller          User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  storeType       StoreType @default(TAI_NGUYEN_MMO) @map("store_type")
  sellerCategory  String    @map("seller_category")
  subCategoryId   String?   @map("sub_category_id") @db.Uuid
  subCategory     SellerSubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  name            String
  price           Decimal   @db.Decimal(18, 2)
  warrantyInfo    String    @default("") @map("warranty_info") @db.Text
  description     String?
  imageUrl        String?   @map("image_url")
  // quantity tính qua VIEW
  publishDate     DateTime? @map("publish_date")
  isActive        Boolean   @default(true) @map("is_active")
  isHidden        Boolean   @default(false) @map("is_hidden")
  isRestricted    Boolean   @default(false) @map("is_restricted")
  salesCount      Int       @default(0) @map("sales_count")
  revenue         Decimal   @default(0) @db.Decimal(18, 2)
  // Duyệt đăng sản phẩm — mặc định APPROVED để sản phẩm đã tồn tại trước migration không bị ẩn;
  // sản phẩm tạo mới sau migration được service set về PENDING tường minh
  approvalStatus       SellerProductApprovalStatus @default(APPROVED) @map("approval_status")
  approvalRejectReason String?   @map("approval_reject_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  stockItems      SellerProductStock[]
  variants        SellerProductVariant[]
  orders          Order[]

  @@index([sellerId])
  @@index([isActive, isHidden, isRestricted])
  @@index([subCategoryId])
  @@index([approvalStatus])
  @@map("seller_products")
}

model SellerProductVariant {
  id           String        @id @default(uuid()) @db.Uuid
  productId    String        @map("product_id") @db.Uuid
  product      SellerProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantName  String?       @map("variant_name") @db.VarChar(100)
  variantPrice Decimal       @map("variant_price") @db.Decimal(18, 2)
  warranty     String        @db.VarChar(50)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  @@index([productId, isActive])
  @@map("seller_product_variants")
}

model SellerProductStock {
  id           String          @id @default(uuid()) @db.Uuid
  productId    String          @map("product_id") @db.Uuid
  product      SellerProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  contentEnc   Bytes           @map("content_enc")
  status       StockItemStatus @default(AVAILABLE)
  soldToUserId String?         @map("sold_to_user_id") @db.Uuid
  orderId      String?         @map("order_id") @db.Uuid
  soldAt       DateTime?       @map("sold_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([productId, status])
  @@map("seller_product_stock")
}

// ====================================================================
// 11. SELLER_WITHDRAWALS
// ====================================================================
model SellerWithdrawal {
  id                   String           @id @default(uuid()) @db.Uuid
  sellerId             String           @map("seller_id") @db.Uuid
  seller               User             @relation(fields: [sellerId], references: [id])
  amount               Decimal          @db.Decimal(18, 2)
  feePercent           Float            @map("fee_percent")
  feeAmount            Decimal          @db.Decimal(18, 2) @map("fee_amount")
  netAmount            Decimal          @db.Decimal(18, 2) @map("net_amount")
  bankNameEnc          Bytes            @map("bank_name_enc")
  bankAccountNumberEnc Bytes            @map("bank_account_number_enc")
  bankAccountHolderEnc Bytes            @map("bank_account_holder_enc")
  status               WithdrawalStatus @default(PENDING)
  qualifyingOrderIds   Json             @default("[]") @map("qualifying_order_ids")
  rejectReason         String?          @map("reject_reason")
  processedByUserId    String?          @map("processed_by_user_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at")
  processedAt          DateTime?        @map("processed_at")

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@map("seller_withdrawals")
}

// ====================================================================
// 12. BANK_CHANGE_REQUESTS
// ====================================================================
model BankChangeRequest {
  id                   String           @id @default(uuid()) @db.Uuid
  sellerId             String           @map("seller_id") @db.Uuid
  seller               User             @relation(fields: [sellerId], references: [id])

  // Thông tin ngân hàng mới (encrypted)
  bankNameEnc          Bytes            @map("bank_name_enc")
  bankAccountNumberEnc Bytes            @map("bank_account_number_enc")
  bankAccountHolderEnc Bytes            @map("bank_account_holder_enc")

  status               BankChangeStatus @default(PENDING)
  rejectReason         String?          @map("reject_reason")
  reviewedByUserId     String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedAt           DateTime?        @map("reviewed_at")

  createdAt            DateTime         @default(now()) @map("created_at")

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@map("bank_change_requests")
}

model SellerReverifyRequest {
  id               String           @id @default(uuid()) @db.Uuid
  sellerId         String           @map("seller_id") @db.Uuid
  seller           User             @relation(fields: [sellerId], references: [id])

  cccdImageUrl     String           @map("cccd_image_url")
  portraitImageUrl String           @map("portrait_image_url")

  status           BankChangeStatus @default(PENDING)
  rejectReason     String?          @map("reject_reason")
  reviewedByUserId String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?        @map("reviewed_at")

  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@map("seller_reverify_requests")
}

// ====================================================================
// 13. SYSTEM_CONFIG
// ====================================================================
model SystemConfig {
  key             String   @id
  value           Json
  description     String?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// ====================================================================
// 13. TICKER_NOTIFICATIONS
// ====================================================================
model TickerNotification {
  id           String   @id @default(uuid()) @db.Uuid
  phone        String
  amount       Decimal  @db.Decimal(18, 2)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([isActive, displayOrder])
  @@map("ticker_notifications")
}

// ====================================================================
// 14. TICKER_TEXTS
// ====================================================================
model TickerText {
  id           String   @id @default(uuid()) @db.Uuid
  text         String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@map("ticker_texts")
}

// ====================================================================
// 15. OTP_CODES
// ====================================================================
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  email       String
  userId      String?    @map("user_id") @db.Uuid
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  ipAddress   String?    @map("ip_address")
  expiresAt   DateTime   @map("expires_at")
  usedAt      DateTime?  @map("used_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ====================================================================
// 16. PENDING_REGISTRATIONS
// ====================================================================
model PendingRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  fullName    String   @map("full_name")
  phone       String?
  otpCodeHash String?  @map("otp_code_hash")
  attempts    Int      @default(0)
  ipAddress   String?  @map("ip_address")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

// ====================================================================
// 17. UNMATCHED_TRANSFERS
// ====================================================================
model UnmatchedTransfer {
  id               String    @id @default(uuid()) @db.Uuid
  content          String
  amount           Decimal   @db.Decimal(18, 2)
  referenceCode    String    @unique @map("reference_code")
  rawPayload       Json      @map("raw_payload")
  candidatesTried  Json      @default("[]") @map("candidates_tried")
  status           String    @default("PENDING")
  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("unmatched_transfers")
}

// ====================================================================
// 18. REVIEWS
// ====================================================================
model Review {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id])
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  productType String   @map("product_type")
  productId   String   @map("product_id") @db.Uuid
  rating      Int
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productType, productId])
  @@index([userId])
  @@map("reviews")
}

// ====================================================================
// 19. COMPLAINTS
// ====================================================================
model Complaint {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  user             User            @relation(fields: [userId], references: [id])
  orderId          String?         @map("order_id") @db.Uuid
  subject          String
  content          String
  status           ComplaintStatus @default(IN_REVIEW)
  resolution       String?
  resolvedByUserId String?         @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?       @map("resolved_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  chatRoom         ChatRoom?

  @@index([userId])
  @@index([status])
  @@map("complaints")
}

// ====================================================================
// 20. CHAT (3-party complaint resolution)
// ====================================================================
model ChatRoom {
  id          String        @id @default(uuid()) @db.Uuid
  complaintId String        @unique @map("complaint_id") @db.Uuid
  complaint   Complaint     @relation(fields: [complaintId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")

  // Quota & turn tracking
  totalMsgCount     Int       @default(0)  @map("total_messages")
  userTurnCount     Int       @default(0)  @map("user_turn_count")
  firstSellerMsgAt  DateTime? @map("first_seller_msg_at")

  // Resolution
  sellerConfirmed   Boolean   @default(false) @map("seller_confirmed")
  sellerConfirmedAt DateTime? @map("seller_confirmed_at")
  userDone          Boolean?  @map("user_done")
  roundTwoOpened    Boolean   @default(false) @map("round_two_opened")

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@map("chat_rooms")
}

model ChatParticipant {
  id       String   @id @default(uuid()) @db.Uuid
  roomId   String   @map("room_id") @db.Uuid
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id") @db.Uuid
  user     User     @relation(fields: [userId], references: [id])
  label    String
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([roomId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model ChatMessage {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String   @map("sender_id") @db.Uuid
  sender      User     @relation(fields: [senderId], references: [id])
  senderName  String   @map("sender_name")
  senderLabel String   @map("sender_label")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// ====================================================================
// 20b. SUPPORT TICKETS (chat hỗ trợ User↔Seller sau khi hết hạn khiếu nại)
// ====================================================================
model SupportTicket {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id])
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation("SupportTicketBuyer", fields: [userId], references: [id])
  sellerId  String   @map("seller_id") @db.Uuid
  seller    User     @relation("SupportTicketSeller", fields: [sellerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages  SupportMessage[]

  @@index([userId])
  @@index([sellerId])
  @@map("support_tickets")
}

model SupportMessage {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String        @map("sender_id") @db.Uuid
  sender     User          @relation(fields: [senderId], references: [id])
  senderName String        @map("sender_name")
  senderRole String        @map("sender_role") @db.VarChar(10)
  content    String
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ====================================================================
// 21. AUDIT_LOGS
// ====================================================================
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ====================================================================
// 22. SELLER_TIER_DEFINITIONS (hạng nhà bán hàng động — thay thế SellerTier enum)
// ====================================================================
model SellerTierDefinition {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique @db.VarChar(50)
  label             String   @db.VarChar(30)
  description       String?  @db.VarChar(200)
  badgeColor        String   @default("gray") @map("badge_color") @db.VarChar(30)
  feePercent        Float    @default(5) @map("fee_percent")
  minWithdrawal     Int      @default(200000) @map("min_withdrawal")
  holdDays          Int      @default(3) @map("hold_days")
  benefits          Json     @default("[]")
  upgradeMinRevenue Int      @default(0) @map("upgrade_min_revenue")
  upgradeMinOrders  Int      @default(0) @map("upgrade_min_orders")
  displayOrder      Int      @default(0) @map("display_order")
  isBuiltIn         Boolean  @default(false) @map("is_built_in")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@map("seller_tier_definitions")
}

// ====================================================================
// 23. PAGE_PERMISSIONS (phân quyền truy cập trang theo role)
// ====================================================================
model PagePermission {
  id              String   @id @default(uuid()) @db.Uuid
  role            Role
  pageKey         String   @map("page_key") @db.VarChar(100)
  isEnabled       Boolean  @default(true) @map("is_enabled")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([role, pageKey])
  @@index([role])
  @@map("page_permissions")
}

// ====================================================================
// 23. PUBLIC PAGE CONFIG (ẩn/hiện + nổi bật + tên trang public)
// ====================================================================

model PublicPageConfig {
  id          String   @id @default(uuid()) @db.Uuid
  pageKey     String   @unique @map("page_key") @db.VarChar(100)
  isVisible   Boolean  @default(true) @map("is_visible")
  isFeatured  Boolean  @default(false) @map("is_featured")
  customLabel String?  @map("custom_label") @db.VarChar(200)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("public_page_configs")
}

// ====================================================================
// 24. TESTIMONIALS (đánh giá do admin tạo)
// ====================================================================

enum TestimonialType {
  COURSE
  SERVICE
}

model Testimonial {
  id               String          @id @default(uuid()) @db.Uuid
  type             TestimonialType
  courseId         String?         @db.Uuid @map("course_id")
  course           Course?         @relation(fields: [courseId], references: [id])
  serviceId        String?         @db.Uuid @map("service_id")
  service          Service?        @relation(fields: [serviceId], references: [id])
  category         String?
  reviewerName     String          @map("reviewer_name")
  reviewerRole     String?         @map("reviewer_role")
  reviewerAvatar   String?         @map("reviewer_avatar")
  reviewerInitials String?         @map("reviewer_initials")
  reviewerColor    String?         @map("reviewer_color")
  content          String
  rating           Int             @default(5)
  isActive         Boolean         @default(true) @map("is_active")
  displayOrder     Int             @default(0) @map("display_order")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([type, isActive, displayOrder])
  @@index([courseId, isActive])
  @@index([serviceId, isActive])
  @@map("testimonials")
}

// ====================================================================
// 25. LIFETIME AFFILIATE
// ====================================================================

// Commission % config: affiliateId = null → global default rule.
// affiliateId set → override for that specific affiliate (always wins over global).
// orderType set → override for that product type (Khóa học/Dịch vụ/Tài nguyên/...).
// productId/categoryId reserved for future per-product/sub-category scoping (unused in v1).
// Specificity when multiple rules match (highest wins): affiliateId+orderType > affiliateId only > orderType only > global default.
model AffiliateCommissionRule {
  id                String     @id @default(uuid()) @db.Uuid
  affiliateId       String?    @map("affiliate_id") @db.Uuid
  affiliate         User?      @relation("AffiliateOwnerRules", fields: [affiliateId], references: [id])
  orderType         OrderType? @map("order_type")
  productId         String?    @map("product_id") @db.Uuid
  categoryId        String?    @map("category_id") @db.Uuid
  commissionPercent Decimal    @db.Decimal(5, 2) @map("commission_percent")
  priority          Int        @default(0)
  isActive          Boolean    @default(true) @map("is_active")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  @@index([affiliateId])
  @@index([orderType])
  @@map("affiliate_commission_rules")
}

// Per-order commission ledger — one row per qualifying order.
model AffiliateCommission {
  id                String   @id @default(uuid()) @db.Uuid
  affiliateId       String   @map("affiliate_id") @db.Uuid
  affiliate         User     @relation("AffiliateEarner", fields: [affiliateId], references: [id])
  customerId        String   @map("customer_id") @db.Uuid
  customer          User     @relation("AffiliateCustomer", fields: [customerId], references: [id])
  orderId           String   @unique @map("order_id") @db.Uuid
  order             Order    @relation(fields: [orderId], references: [id])

  orderAmount       Decimal  @db.Decimal(18, 2) @map("order_amount")
  commissionPercent Decimal  @db.Decimal(5, 2)  @map("commission_percent")
  amount            Decimal  @db.Decimal(18, 2)

  status           AffiliateCommissionStatus @default(PENDING)
  withdrawn        Boolean  @default(false)
  approvedByUserId String?  @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at")
  voidedAt         DateTime? @map("voided_at")
  voidReason       String?  @map("void_reason")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([affiliateId, status])
  @@index([customerId])
  @@index([createdAt])
  @@map("affiliate_commissions")
}

// Click tracking — dedicated table (not a counter) so admin reports can
// group by day/month/year.
model AffiliateClick {
  id          String   @id @default(uuid()) @db.Uuid
  affiliateId String   @map("affiliate_id") @db.Uuid
  affiliate   User     @relation(fields: [affiliateId], references: [id])
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  landingPath String?  @map("landing_path") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([affiliateId, createdAt])
  @@map("affiliate_clicks")
}

// Independent from SellerWithdrawal — an affiliate's qualifying unit is
// AffiliateCommission rows (earned on OTHER customers' orders), not the
// affiliate's own Order.withdrawn flag, so the two systems never collide.
model AffiliateWithdrawal {
  id                      String                    @id @default(uuid()) @db.Uuid
  affiliateId             String                    @map("affiliate_id") @db.Uuid
  affiliate               User                      @relation(fields: [affiliateId], references: [id])
  amount                  Decimal                   @db.Decimal(18, 2)
  feePercent              Float                     @default(0) @map("fee_percent")
  feeAmount               Decimal                   @default(0) @db.Decimal(18, 2) @map("fee_amount")
  netAmount               Decimal                   @db.Decimal(18, 2) @map("net_amount")
  bankNameEnc             Bytes?                    @map("bank_name_enc")
  bankAccountNumberEnc    Bytes?                    @map("bank_account_number_enc")
  bankAccountHolderEnc    Bytes?                    @map("bank_account_holder_enc")
  qualifyingCommissionIds Json                      @map("qualifying_commission_ids")
  status                  AffiliateWithdrawalStatus @default(PENDING)
  rejectReason            String?                   @map("reject_reason")
  processedByUserId       String?                   @map("processed_by_user_id") @db.Uuid
  processedAt             DateTime?                 @map("processed_at")
  createdAt               DateTime                  @default(now()) @map("created_at")

  @@index([affiliateId, status])
  @@map("affiliate_withdrawals")
}

