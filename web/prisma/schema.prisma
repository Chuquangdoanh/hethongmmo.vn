// ====================================================================
// Generator & Datasource
// ====================================================================
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ====================================================================
// ENUMS
// ====================================================================
enum Role {
  USER
  SELLER
  STAFF
  ADMIN
}

enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  BANNED
  DELETED
}

enum SellerStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum Platform {
  FACEBOOK
  TIKTOK
  GOOGLE
  INSTAGRAM
  YOUTUBE
  ICLOUD
  ZALO
  TELEGRAM
  TWITTER
  OTHER
}

enum LearningFormat {
  ONLINE
  OFFLINE
  HYBRID
}

enum CourseBadge {
  NONE
  HOT
  POPULAR
  TREND
  NEW
  VIP
}

enum OrderType {
  SERVICE
  COURSE
  TUTTRICK
  MMO_PRODUCT
  SELLER_PRODUCT
}

enum OrderStatus {
  PENDING
  PROCESSING
  DONE
  CANCELLED
  REFUNDED
  DISPUTED
  FROZEN
}

enum TxType {
  DEPOSIT_AUTO
  DEPOSIT_MANUAL
  BUY_SERVICE
  BUY_COURSE
  BUY_TUTTRICK
  BUY_MMO_PRODUCT
  BUY_SELLER_PRODUCT
  REFUND
  SELLER_REGISTRATION
  SELLER_SLOT_PURCHASE
  SELLER_PAYOUT
  WITHDRAWAL_FEE
  ADMIN_ADJUSTMENT
  COMPLAINT_DEDUCTION
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
}

enum OtpPurpose {
  REGISTER
  LOGIN_2FA
  RESET_PASSWORD
  EMAIL_VERIFY
  WITHDRAWAL_CONFIRM
  SENSITIVE_ACTION
}

enum NotificationType {
  DEPOSIT
  PURCHASE
  ORDER_STATUS
  SELLER_APPROVED
  WITHDRAWAL_STATUS
  SYSTEM
  PROMOTION
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum StockItemStatus {
  AVAILABLE
  RESERVED
  SOLD
}

// ====================================================================
// 1. USERS & AUTH
// ====================================================================
model User {
  id                   String        @id @default(uuid()) @db.Uuid

  email                String        @unique @db.VarChar(255)
  emailVerifiedAt      DateTime?     @map("email_verified_at")
  passwordHash         String        @map("password_hash")
  fullName             String        @map("full_name")
  phone                String?

  role                 Role          @default(USER)
  status               AccountStatus @default(PENDING_VERIFICATION)

  balance              Decimal       @default(0) @db.Decimal(18, 2)
  totalDeposited       Decimal       @default(0) @db.Decimal(18, 2) @map("total_deposited")
  totalSpent           Decimal       @default(0) @db.Decimal(18, 2) @map("total_spent")

  // Giảm giá khi mua Service/Course/TutTrick
  // 0 = dùng tier tự động theo totalDeposited; > 0 = admin override cứng
  discountPercent      Int           @default(0) @map("discount_percent")

  sellerStatus         SellerStatus  @default(NONE) @map("seller_status")
  sellerTier           String        @default("STANDARD") @map("seller_tier") @db.VarChar(50)
  sellerCategory       String?       @map("seller_category")
  maxSellerProducts    Int           @default(3) @map("max_seller_products")

  bankNameEnc          Bytes?        @map("bank_name_enc")
  bankAccountNumberEnc Bytes?        @map("bank_account_number_enc")
  bankAccountHolderEnc Bytes?        @map("bank_account_holder_enc")
  cccdImageUrl         String?       @map("cccd_image_url")
  portraitImageUrl     String?       @map("portrait_image_url")
  facebookUrl          String?       @map("facebook_url") @db.VarChar(500)
  telegramUsername     String?       @map("telegram_username") @db.VarChar(100)

  twoFactorSecretEnc   Bytes?        @map("two_factor_secret_enc")
  twoFactorEnabled     Boolean       @default(false) @map("two_factor_enabled")
  shopLocked           Boolean       @default(false) @map("shop_locked")

  lastLoginAt          DateTime?     @map("last_login_at")
  lastLoginIp          String?       @map("last_login_ip")
  failedLoginCount     Int           @default(0) @map("failed_login_count")
  lockedUntil          DateTime?     @map("locked_until")

  // 8 ký tự đầu UUID (bỏ dấu -) dùng cho SePay webhook matching
  uidPrefix            String        @map("uid_prefix") @db.VarChar(8)

  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  deletedAt            DateTime?     @map("deleted_at")

  sessions             Session[]
  refreshTokens        RefreshToken[]
  orders               Order[]
  transactions         Transaction[]
  notifications        Notification[]
  sellerRequest        SellerRequest?
  sellerProducts       SellerProduct[]
  sellerWithdrawals    SellerWithdrawal[]
  reviews              Review[]
  complaints           Complaint[]
  auditLogsAsActor     AuditLog[]    @relation("AuditActor")
  loginAttempts        LoginAttempt[]
  chatParticipations   ChatParticipant[]
  chatMessages         ChatMessage[]

  @@index([email])
  @@index([uidPrefix])
  @@index([status])
  @@index([role])
  @@index([sellerStatus])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique @map("session_token") @db.VarChar(128)
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  family    String    @db.VarChar(64)
  revoked   Boolean   @default(false)
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  email      String
  ipAddress  String   @map("ip_address")
  userAgent  String?  @map("user_agent")
  success    Boolean
  failReason String?  @map("fail_reason")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

// ====================================================================
// 2. SERVICES
// ====================================================================
model ServiceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  iconUrl   String?  @map("icon_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("service_categories")
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  slug            String    @unique
  name            String
  thumbnail       String?
  platform        Platform
  category        String
  price           Decimal   @db.Decimal(18, 2)
  successRate     Int       @default(100) @map("success_rate")
  processingTime  String?   @map("processing_time")
  rating          Float     @default(0)
  totalOrders     Int       @default(0) @map("total_orders")
  totalViews      Int       @default(0) @map("total_views")
  isActive        Boolean   @default(true) @map("is_active")
  isFeatured      Boolean   @default(false) @map("is_featured")
  description     String?
  seoTitle        String?   @map("seo_title")
  seoDescription  String?   @map("seo_description")
  customerCount    Int       @default(0) @map("customer_count")
  reviewCount      Int       @default(0) @map("review_count")
  platformVariants Json      @default("[]") @map("platform_variants")
  warrantyOptions  Json      @default("[]") @map("warranty_options")
  productList      Json      @default("[]") @map("product_list")
  displayOrder        Int       @default(0) @map("display_order")
  requiresAccountType Boolean   @default(false) @map("requires_account_type")
  requiresCccd        Boolean   @default(false) @map("requires_cccd")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  orders          Order[]
  testimonials    Testimonial[]

  @@index([slug])
  @@index([platform])
  @@index([isActive, isFeatured])
  @@index([category])
  @@map("services")
}

// ====================================================================
// 3. COURSES
// ====================================================================
model CourseCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  icon         String   @default("") // URL icon từ svgl.app
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([displayOrder])
  @@map("course_categories")
}

model Course {
  id               String         @id @default(uuid()) @db.Uuid
  slug             String         @unique
  name             String
  thumbnail        String?
  description      String?
  category         String
  learningFormat   LearningFormat @map("learning_format")
  originalPrice    Decimal        @db.Decimal(18, 2) @map("original_price")
  salePrice        Decimal        @db.Decimal(18, 2) @map("sale_price")
  duration         String?
  studentCount     Int            @default(0) @map("student_count")
  instructorName   String?        @map("instructor_name")
  rating           Float          @default(0)
  contentList      Json           @default("[]") @map("content_list")
  platformVariants Json           @default("[]") @map("platform_variants")
  badge            CourseBadge    @default(NONE)
  saleDeadline     DateTime?      @map("sale_deadline") @db.Date
  youtubeUrl       String?        @map("youtube_url")
  seoTitle         String?        @map("seo_title")
  seoDescription   String?        @map("seo_description")
  totalOrders      Int            @default(0) @map("total_orders")
  totalViews       Int            @default(0) @map("total_views")
  isActive            Boolean        @default(true) @map("is_active")
  displayOrder        Int            @default(0) @map("display_order")
  requiresAccountType     Boolean        @default(false) @map("requires_account_type")
  requiresCccd            Boolean        @default(false) @map("requires_cccd")
  commitments             Json           @default("[]") @map("commitments")
  registrationProcedure   String?        @map("registration_procedure")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  deletedAt           DateTime?      @map("deleted_at")

  orders           Order[]
  testimonials     Testimonial[]

  @@index([slug])
  @@index([category])
  @@index([isActive, displayOrder])
  @@map("courses")
}

// ====================================================================
// 4. TUT_TRICKS
// ====================================================================
model TutTrick {
  id             String    @id @default(uuid()) @db.Uuid
  slug           String    @unique
  name           String
  thumbnail      String?
  platform       Platform
  category       String
  tier           String    @default("Miễn phí")
  price          Decimal   @db.Decimal(18, 2) @default(0)
  description    String?
  contentUrlEnc  Bytes?    @map("content_url_enc")
  docs           String?
  seoTitle       String?   @map("seo_title")
  seoDescription String?   @map("seo_description")
  warrantyPolicy String?   @map("warranty_policy")
  processingTime String?   @map("processing_time")
  isActive            Boolean   @default(true) @map("is_active")
  isFeatured          Boolean   @default(false) @map("is_featured")
  totalOrders         Int       @default(0) @map("total_orders")
  totalViews          Int       @default(0) @map("total_views")
  successRate         Int       @default(100) @map("success_rate")
  rating              Float     @default(0)
  displayOrder        Int       @default(0) @map("display_order")
  publishedDate       DateTime? @map("published_date") @db.Date
  requiresAccountType Boolean   @default(false) @map("requires_account_type")
  requiresCccd        Boolean   @default(false) @map("requires_cccd")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  orders         Order[]

  @@index([slug])
  @@index([platform])
  @@index([isActive, isFeatured])
  @@map("tut_tricks")
}

// ====================================================================
// 5. MMO_PRODUCTS + ITEMS
// ====================================================================
model MmoProduct {
  id            String    @id @default(uuid()) @db.Uuid
  slug          String    @unique
  name          String
  thumbnail     String?
  category      String
  categoryGroup String    @map("category_group")
  price         Decimal   @db.Decimal(18, 2)
  description   String?
  rating        Float     @default(0)
  totalOrders   Int       @default(0) @map("total_orders")
  totalViews    Int       @default(0) @map("total_views")
  isActive            Boolean   @default(true) @map("is_active")
  isFeatured          Boolean   @default(false) @map("is_featured")
  displayOrder        Int       @default(0) @map("display_order")
  requiresAccountType Boolean   @default(false) @map("requires_account_type")
  requiresCccd        Boolean   @default(false) @map("requires_cccd")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  items         MmoProductItem[]
  orders        Order[]

  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@map("mmo_products")
}

model MmoProductItem {
  id           String          @id @default(uuid()) @db.Uuid
  productId    String          @map("product_id") @db.Uuid
  product      MmoProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  valueEnc     Bytes           @map("value_enc")
  status       StockItemStatus @default(AVAILABLE)
  soldToUserId String?         @map("sold_to_user_id") @db.Uuid
  orderId      String?         @map("order_id") @db.Uuid
  soldAt       DateTime?       @map("sold_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([productId, status])
  @@index([orderId])
  @@map("mmo_product_items")
}

// ====================================================================
// 6. RESOURCE CATEGORIES
// ====================================================================
model ResourceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  iconUrl   String?  @map("icon_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("resource_categories")
}

model TutTrickCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  iconUrl   String?  @map("icon_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("tut_trick_categories")
}

// ====================================================================
// 7. ORDERS
// ====================================================================
model Order {
  id              String         @id @default(uuid()) @db.Uuid
  orderCode       String         @unique @map("order_code")
  userId          String         @map("user_id") @db.Uuid
  user            User           @relation(fields: [userId], references: [id])

  orderType       OrderType      @map("order_type")
  serviceId       String?        @map("service_id") @db.Uuid
  service         Service?       @relation(fields: [serviceId], references: [id])
  courseId        String?        @map("course_id") @db.Uuid
  course          Course?        @relation(fields: [courseId], references: [id])
  tutTrickId      String?        @map("tut_trick_id") @db.Uuid
  tutTrick        TutTrick?      @relation(fields: [tutTrickId], references: [id])
  mmoProductId    String?        @map("mmo_product_id") @db.Uuid
  mmoProduct      MmoProduct?    @relation(fields: [mmoProductId], references: [id])
  sellerProductId String?        @map("seller_product_id") @db.Uuid
  sellerProduct   SellerProduct? @relation(fields: [sellerProductId], references: [id])
  sellerId        String?        @map("seller_id") @db.Uuid

  itemName        String         @map("item_name")
  originalPrice   Decimal        @db.Decimal(18, 2) @map("original_price")
  finalPrice      Decimal        @db.Decimal(18, 2) @map("final_price")
  warrantyVariant String?        @map("warranty_variant")
  customerNote    String?        @map("customer_note")
  paymentMethod   String         @default("BALANCE") @map("payment_method")
  status          OrderStatus    @default(PENDING)

  deliveredItemId       String?        @map("delivered_item_id") @db.Uuid
  tutTrickContentUrlEnc Bytes?         @map("tut_trick_content_url_enc")
  tutTrickDocs          String?        @map("tut_trick_docs")
  idempotencyKey        String?        @unique @map("idempotency_key")
  withdrawn             Boolean        @default(false)

  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  completedAt     DateTime?      @map("completed_at")

  transactions    Transaction[]
  review          Review?

  @@index([userId, createdAt])
  @@index([status])
  @@index([orderType])
  @@index([sellerId])
  @@index([orderCode])
  @@map("orders")
}

// ====================================================================
// 7. TRANSACTIONS
// ====================================================================
model Transaction {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id])
  orderId       String?  @map("order_id") @db.Uuid
  order         Order?   @relation(fields: [orderId], references: [id])
  type          TxType
  amount        Decimal  @db.Decimal(18, 2)
  description   String
  balanceBefore Decimal  @db.Decimal(18, 2) @map("balance_before")
  balanceAfter  Decimal  @db.Decimal(18, 2) @map("balance_after")
  referenceCode   String?  @unique @map("reference_code")
  metadata        Json?
  transactionDate String?  @db.VarChar(30) @map("transaction_date")
  accountNumber   String?  @db.VarChar(50) @map("account_number")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([type])
  @@index([referenceCode])
  @@map("transactions")
}

// ====================================================================
// 8. NOTIFICATIONS
// ====================================================================
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false) @map("is_read")
  meta      Json?
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ====================================================================
// 9. SELLER_REQUESTS
// ====================================================================
model SellerRequest {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @unique @map("user_id") @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         String
  fee              Decimal      @default(50000) @db.Decimal(18, 2)
  status           SellerStatus @default(PENDING)
  approvedCategory String?      @map("approved_category")
  rejectReason     String?      @map("reject_reason")
  reviewedByUserId String?      @map("reviewed_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  approvedAt       DateTime?    @map("approved_at")
  rejectedAt       DateTime?    @map("rejected_at")

  @@index([status])
  @@map("seller_requests")
}

// ====================================================================
// 10. SELLER_PRODUCTS + STOCK
// ====================================================================
model SellerProduct {
  id             String    @id @default(uuid()) @db.Uuid
  sellerId       String    @map("seller_id") @db.Uuid
  seller         User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerCategory String    @map("seller_category")
  name           String
  price          Decimal   @db.Decimal(18, 2)
  description    String?
  imageUrl       String?   @map("image_url")
  // quantity tính qua VIEW
  publishDate    DateTime? @map("publish_date")
  isActive       Boolean   @default(true) @map("is_active")
  isHidden       Boolean   @default(false) @map("is_hidden")
  isRestricted   Boolean   @default(false) @map("is_restricted")
  salesCount     Int       @default(0) @map("sales_count")
  revenue        Decimal   @default(0) @db.Decimal(18, 2)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  stockItems     SellerProductStock[]
  orders         Order[]

  @@index([sellerId])
  @@index([isActive, isHidden, isRestricted])
  @@map("seller_products")
}

model SellerProductStock {
  id           String          @id @default(uuid()) @db.Uuid
  productId    String          @map("product_id") @db.Uuid
  product      SellerProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)
  contentEnc   Bytes           @map("content_enc")
  status       StockItemStatus @default(AVAILABLE)
  soldToUserId String?         @map("sold_to_user_id") @db.Uuid
  orderId      String?         @map("order_id") @db.Uuid
  soldAt       DateTime?       @map("sold_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([productId, status])
  @@map("seller_product_stock")
}

// ====================================================================
// 11. SELLER_WITHDRAWALS
// ====================================================================
model SellerWithdrawal {
  id                   String           @id @default(uuid()) @db.Uuid
  sellerId             String           @map("seller_id") @db.Uuid
  seller               User             @relation(fields: [sellerId], references: [id])
  amount               Decimal          @db.Decimal(18, 2)
  feePercent           Float            @map("fee_percent")
  feeAmount            Decimal          @db.Decimal(18, 2) @map("fee_amount")
  netAmount            Decimal          @db.Decimal(18, 2) @map("net_amount")
  bankNameEnc          Bytes            @map("bank_name_enc")
  bankAccountNumberEnc Bytes            @map("bank_account_number_enc")
  bankAccountHolderEnc Bytes            @map("bank_account_holder_enc")
  status               WithdrawalStatus @default(PENDING)
  qualifyingOrderIds   Json             @default("[]") @map("qualifying_order_ids")
  rejectReason         String?          @map("reject_reason")
  processedByUserId    String?          @map("processed_by_user_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at")
  processedAt          DateTime?        @map("processed_at")

  @@index([sellerId, status])
  @@index([status, createdAt])
  @@map("seller_withdrawals")
}

// ====================================================================
// 12. SYSTEM_CONFIG
// ====================================================================
model SystemConfig {
  key             String   @id
  value           Json
  description     String?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// ====================================================================
// 13. TICKER_NOTIFICATIONS
// ====================================================================
model TickerNotification {
  id           String   @id @default(uuid()) @db.Uuid
  phone        String
  amount       Decimal  @db.Decimal(18, 2)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([isActive, displayOrder])
  @@map("ticker_notifications")
}

// ====================================================================
// 14. TICKER_TEXTS
// ====================================================================
model TickerText {
  id           String   @id @default(uuid()) @db.Uuid
  text         String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@map("ticker_texts")
}

// ====================================================================
// 15. OTP_CODES
// ====================================================================
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  email       String
  userId      String?    @map("user_id") @db.Uuid
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  ipAddress   String?    @map("ip_address")
  expiresAt   DateTime   @map("expires_at")
  usedAt      DateTime?  @map("used_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ====================================================================
// 16. PENDING_REGISTRATIONS
// ====================================================================
model PendingRegistration {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  fullName    String   @map("full_name")
  phone       String?
  otpCodeHash String?  @map("otp_code_hash")
  attempts    Int      @default(0)
  ipAddress   String?  @map("ip_address")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("pending_registrations")
}

// ====================================================================
// 17. UNMATCHED_TRANSFERS
// ====================================================================
model UnmatchedTransfer {
  id               String    @id @default(uuid()) @db.Uuid
  content          String
  amount           Decimal   @db.Decimal(18, 2)
  referenceCode    String    @unique @map("reference_code")
  rawPayload       Json      @map("raw_payload")
  candidatesTried  Json      @default("[]") @map("candidates_tried")
  status           String    @default("PENDING")
  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("unmatched_transfers")
}

// ====================================================================
// 18. REVIEWS
// ====================================================================
model Review {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @unique @map("order_id") @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id])
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  productType String   @map("product_type")
  productId   String   @map("product_id") @db.Uuid
  rating      Int
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productType, productId])
  @@index([userId])
  @@map("reviews")
}

// ====================================================================
// 19. COMPLAINTS
// ====================================================================
model Complaint {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  user             User            @relation(fields: [userId], references: [id])
  orderId          String?         @map("order_id") @db.Uuid
  subject          String
  content          String
  status           ComplaintStatus @default(OPEN)
  resolution       String?
  resolvedByUserId String?         @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?       @map("resolved_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  chatRoom         ChatRoom?

  @@index([userId])
  @@index([status])
  @@map("complaints")
}

// ====================================================================
// 20. CHAT (3-party complaint resolution)
// ====================================================================
model ChatRoom {
  id          String        @id @default(uuid()) @db.Uuid
  complaintId String        @unique @map("complaint_id") @db.Uuid
  complaint   Complaint     @relation(fields: [complaintId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@map("chat_rooms")
}

model ChatParticipant {
  id       String   @id @default(uuid()) @db.Uuid
  roomId   String   @map("room_id") @db.Uuid
  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id") @db.Uuid
  user     User     @relation(fields: [userId], references: [id])
  label    String
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([roomId, userId])
  @@index([userId])
  @@map("chat_participants")
}

model ChatMessage {
  id          String   @id @default(uuid()) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid
  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId    String   @map("sender_id") @db.Uuid
  sender      User     @relation(fields: [senderId], references: [id])
  senderName  String   @map("sender_name")
  senderLabel String   @map("sender_label")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// ====================================================================
// 21. AUDIT_LOGS
// ====================================================================
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ====================================================================
// 22. SELLER_TIER_DEFINITIONS (hạng nhà bán hàng động — thay thế SellerTier enum)
// ====================================================================
model SellerTierDefinition {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique @db.VarChar(50)
  label             String   @db.VarChar(30)
  description       String?  @db.VarChar(200)
  badgeColor        String   @default("gray") @map("badge_color") @db.VarChar(30)
  feePercent        Float    @default(5) @map("fee_percent")
  minWithdrawal     Int      @default(200000) @map("min_withdrawal")
  holdDays          Int      @default(3) @map("hold_days")
  benefits          Json     @default("[]")
  upgradeMinRevenue Int      @default(0) @map("upgrade_min_revenue")
  upgradeMinOrders  Int      @default(0) @map("upgrade_min_orders")
  displayOrder      Int      @default(0) @map("display_order")
  isBuiltIn         Boolean  @default(false) @map("is_built_in")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@map("seller_tier_definitions")
}

// ====================================================================
// 23. PAGE_PERMISSIONS (phân quyền truy cập trang theo role)
// ====================================================================
model PagePermission {
  id              String   @id @default(uuid()) @db.Uuid
  role            Role
  pageKey         String   @map("page_key") @db.VarChar(100)
  isEnabled       Boolean  @default(true) @map("is_enabled")
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([role, pageKey])
  @@index([role])
  @@map("page_permissions")
}

// ====================================================================
// 23. TESTIMONIALS (đánh giá do admin tạo)
// ====================================================================

enum TestimonialType {
  COURSE
  SERVICE
}

model Testimonial {
  id               String          @id @default(uuid()) @db.Uuid
  type             TestimonialType
  courseId         String?         @db.Uuid @map("course_id")
  course           Course?         @relation(fields: [courseId], references: [id])
  serviceId        String?         @db.Uuid @map("service_id")
  service          Service?        @relation(fields: [serviceId], references: [id])
  category         String?
  reviewerName     String          @map("reviewer_name")
  reviewerRole     String?         @map("reviewer_role")
  reviewerAvatar   String?         @map("reviewer_avatar")
  reviewerInitials String?         @map("reviewer_initials")
  reviewerColor    String?         @map("reviewer_color")
  content          String
  rating           Int             @default(5)
  isActive         Boolean         @default(true) @map("is_active")
  displayOrder     Int             @default(0) @map("display_order")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([type, isActive, displayOrder])
  @@index([courseId, isActive])
  @@index([serviceId, isActive])
  @@map("testimonials")
}
